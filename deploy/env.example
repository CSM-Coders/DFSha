# variables del despliegue en varias vms (copia a deploy/control/.env y deploy/data/.env), el mismo secreto en todas las vms: python3 -c "import secrets; print(secrets.token_hex(32))"
CLUSTER_SECRET=
# (opcional) clave aes-256 de los bloques, 64 hex, si no se pone se saca de CLUSTER_SECRET
DATA_KEY=
ADMIN_PASSWORD=

# vm de control node
PRIVATE_IP=10.0.1.11  # ip privada de esta vm
RAFT_PEERS=10.0.1.12:4321,10.0.1.13:4321  # ips privadas de las otras dos vms de control

# vm de datanode
NODE_ID=datanode1  # único por vm
PUBLIC_IP=54.12.34.56  # ip pública (o dns) de esta vm, la que usan los clientes
# PRIVATE_IP=10.0.1.21  # la misma variable de arriba, con la ip privada de esta vm
CONTROL_NODE_URLS=https://10.0.1.11:8000,https://10.0.1.12:8000,https://10.0.1.13:8000
