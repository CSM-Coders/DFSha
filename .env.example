# copia este archivo a .env y cambia los valores, .env no se sube a git

# secreto compartido del cluster: firma los tokens de sesión y de acceso a bloques, autentica a los datanodes ante los control nodes, cifra el tráfico raft y (si no defines DATA_KEY) saca la clave de cifrado de bloques, genera uno largo con python3 -c "import secrets; print(secrets.token_hex(32))"
CLUSTER_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# (opcional) clave aes-256 para cifrar los bloques en disco, 64 caracteres hexadecimales, si la cambias los bloques que ya están guardados no se pueden leer
DATA_KEY=

# (opcional) si la defines se crea el usuario "admin" con esta contraseña al arrancar
ADMIN_PASSWORD=
